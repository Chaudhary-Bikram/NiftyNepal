SITE_URL=http://localhost:3000
AUTH_SECRET=change-me-to-a-long-random-string
# Matches docker-compose.yml. For hosted Postgres (Neon, Supabase, Railway, RDS) paste its connection string.
DATABASE_URL=postgres://nifty:nifty@localhost:5432/niftynepal
# Set to true if your provider requires SSL
DATABASE_SSL=false

# --- Cloudinary (photo uploads) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=niftynepal/ads

# --- SMTP (email OTP verification) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="NiftyNepal <no-reply@yourdomain.com>"
